# Placeholder development values only. Copy to .env; never commit real secrets.
POSTGRES_USER=finsight
POSTGRES_PASSWORD=finsight_dev_password
POSTGRES_DB=finsight
POSTGRES_PORT=5433
# Used by the CLI when running outside Docker:
DATABASE_URL=postgresql://finsight:finsight_dev_password@localhost:5433/finsight

# Text-to-SQL / investigator: leave ANTHROPIC_API_KEY empty to run without live LLM (demo queries and facts-only drafts still work)
ANTHROPIC_API_KEY=
BI_MODEL=claude-sonnet-5-5
PII_MASK_KEY=change-me

# Authentication: server-side keys "key:role:identity" (roles viewer|analyst). Identity in audit logs comes from the key, not from the UI.
# LOCAL DEMO PLACEHOLDERS - change them. The dashboard's server-side proxy uses API_KEY, which must equal one analyst key above.
AUTH_KEYS=dev-viewer-key-change-me:viewer:viewer-demo,dev-analyst-key-change-me:analyst:analyst-demo
AUTH_DISABLED=false
API_KEY=dev-analyst-key-change-me
